<div class="logout-modal-backdrop" id="logoutModalBackdrop" aria-hidden="true">
  <div class="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
    <div class="logout-modal-icon">
      <svg viewBox="0 0 24 24"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path></svg>
    </div>
    <h3 id="logoutModalTitle">Sair da conta</h3>
    <p>Tem certeza que deseja sair da sua conta?</p>
    <div class="logout-modal-actions">
      <button type="button" class="logout-modal-cancel" id="logoutModalCancel">Cancelar</button>
      <button type="button" class="logout-modal-confirm" id="logoutModalConfirm">Sair</button>
    </div>
  </div>
</div>

<script>
  (function () {
    const overlay = document.getElementById('mobile-drawer-overlay');
    const openBtn = document.getElementById('bottom-nav-menu-btn');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const logoutModal = document.getElementById('logoutModalBackdrop');
    const logoutConfirmBtn = document.getElementById('logoutModalConfirm');
    const logoutCancelBtn = document.getElementById('logoutModalCancel');
    let pendingLogoutUrl = '/logout';

    function closeLogoutModal() {
      if (!logoutModal) return;
      logoutModal.classList.remove('open');
      logoutModal.setAttribute('aria-hidden', 'true');
    }

    function openLogoutModal() {
      if (!logoutModal) return;
      logoutModal.classList.add('open');
      logoutModal.setAttribute('aria-hidden', 'false');
    }

    document.querySelectorAll('[data-logout="true"]').forEach((link) => {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        pendingLogoutUrl = link.getAttribute('href') || '/logout';
        openLogoutModal();
      });
    });

    logoutCancelBtn?.addEventListener('click', closeLogoutModal);
    logoutModal?.addEventListener('click', function (event) {
      if (event.target === logoutModal) closeLogoutModal();
    });
    logoutConfirmBtn?.addEventListener('click', function () {
      closeLogoutModal();
      window.location.href = pendingLogoutUrl;
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && logoutModal && logoutModal.classList.contains('open')) {
        closeLogoutModal();
      }
    });

    function obterMensagemEmergencia() {
      const dataAtual = new Date().toLocaleString('pt-BR');
      const contatos = JSON.parse(localStorage.getItem('fenix_contatos') || '[]');
      const primeiroContato = contatos[0];
      const destino = primeiroContato && primeiroContato.celular
        ? primeiroContato.celular.replace(/\D/g, '')
        : '190';

      return new Promise((resolve) => {
        if (!navigator.geolocation) {
          resolve(`🚨 ALERTA DE EMERGÊNCIA\n\nEstou em perigo e preciso de ajuda imediatamente.\nHorário: ${dataAtual}\n\nLocalização: indisponível no momento.\n\nMensagem enviada pelo botão de emergência do aplicativo Fênix.`);
          return;
        }

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            const mapa = `https://maps.google.com/?q=${lat},${lng}`;
            resolve(`🚨 ALERTA DE EMERGÊNCIA\n\nEstou em perigo e preciso de ajuda imediatamente.\nHorário: ${dataAtual}\n\nMinha localização: ${mapa}\n\nMensagem enviada pelo botão de emergência do aplicativo Fênix.`);
          },
          () => {
            resolve(`🚨 ALERTA DE EMERGÊNCIA\n\nEstou em perigo e preciso de ajuda imediatamente.\nHorário: ${dataAtual}\n\nLocalização: indisponível no momento.\n\nMensagem enviada pelo botão de emergência do aplicativo Fênix.`);
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      }).then((mensagem) => ({ mensagem, destino }));
    }

    function acionarEmergencia() {
      obterMensagemEmergencia().then(({ mensagem, destino }) => {
        const telefone = destino.length === 11 ? `55${destino}` : destino;

        if (destino === '190') {
          window.location.href = 'tel:190';
          return;
        }

        const link = `https://api.whatsapp.com/send?phone=${telefone}&text=${encodeURIComponent(mensagem)}`;
        window.open(link, '_blank');
      });
    }

    document.getElementById('emergency-header-btn')?.addEventListener('click', acionarEmergencia);
    document.getElementById('bottom-nav-emergency-btn')?.addEventListener('click', acionarEmergencia);

    function openDrawer() {
      if (!overlay || !openBtn) return;
      overlay.classList.add('active');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-aberto');
    }

    function closeDrawer() {
      if (!overlay || !openBtn) return;
      overlay.classList.remove('active');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-aberto');
    }

    if (openBtn && closeBtn && overlay) {
      openBtn.addEventListener('click', openDrawer);
      closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeDrawer();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDrawer();
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024) closeDrawer();
      });
    }
  })();
</script>
