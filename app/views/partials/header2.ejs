<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Allura&display=swap"
  rel="stylesheet"
/>
<link rel="stylesheet" href="../css/header.css" />

<%
  /* Ativa o link correspondente à rota atual, se a rota for passada pela view */
  const _path = typeof currentPath !== 'undefined' ? currentPath : '';
  function isActive(href) {
    return _path === href ? 'active' : '';
  }
%>

<!-- ============================================================
     TOP HEADER — claro, fixo, com marca e ações rápidas
     ============================================================ -->
<header class="site-topbar">
  <a href="/text" class="topbar-brand">
    <img src="../imgs/logo.png" alt="Logo Fênix" />
    <span>Fênix</span>
  </a>

  <div class="topbar-actions">
    <button
      class="emergency-header-btn"
      id="emergency-header-btn"
      type="button"
      aria-label="Botão de emergência"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z"></path>
        <path d="M12 7v5"></path>
        <path d="M12 16h.01"></path>
      </svg>
      <span>Emergência</span>
    </button>

    <a
      href="<%= locals.usuario ? '/perfil_usuario' : '/cadastro' %>"
      class="topbar-icon-btn"
      aria-label="<%= locals.usuario ? 'Meu perfil' : 'Entrar ou cadastrar' %>"
    >
      <% if (locals.usuario && locals.usuario.foto_url) { %>
        <img src="<%= locals.usuario.foto_url %>" alt="Foto de perfil" class="topbar-avatar" />
      <% } else if (locals.usuario && locals.usuario.nome) { %>
        <img
          src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(locals.usuario.nome) %>&background=c49a4a&color=fff&size=64"
          alt="Foto de perfil"
          class="topbar-avatar"
        />
      <% } else { %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
        </svg>
      <% } %>
    </a>

    <button
      class="topbar-icon-btn topbar-menu-btn"
      id="topbar-menu-btn"
      aria-label="Configurações"
      type="button"
      onclick="window.location.href='/configuracoes'"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3"></circle>
        <path
          d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
        ></path>
      </svg>
    </button>
  </div>
</header>

