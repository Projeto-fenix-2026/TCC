<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/login.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <script src="../js/login.js" defer type="module"></script>
    <title>Login</title>
    <%- include('../partials/pwa-head.ejs') %>
</head>

<body>
    
    <%- include('../partials/header2.ejs') %>

    <% let erroValidacao={"email":"", "password" :"" }; let msgErro={ "email" :"", "password" :"" }; if(erros) {
        erros.errors.forEach(function(erro) { if (erro.path=="email" ) { erroValidacao.email="erro" ,
        msgErro.email=erro.msg } if (erro.path=="password" ) { erroValidacao.password="erro" , msgErro.password=erro.msg
        } }) }; %>
        
            <main>
                <section class="container">
                    <section class="form-image">
                        <img src="../imgs/svg2.svg" alt="Login Illustration">
                    </section>
                    <section class="form">

                        <form method="post" action="/login" id="loginForm">

                            <section class="form-header">
                                <section class="title">
                                    <h1>Entrar</h1>
                                </section>
                            </section>

                            <section class="input-group">
                                <section class="input-box">
                                    <label for="email">E-mail</label>
                                    <input id="email" type="email" name="email" placeholder="Digite seu e-mail"
                                        value="<%= valores.email  %>" class="<%= erroValidacao.email %>" required>
                                    <span>
                                        <%= msgErro.email %>
                                    </span><br>
                                </section>

                                <section class="input-box">
                                    <label for="password">Senha</label>
                                    <section class="password-wrapper">
                                        <input id="password" type="password" name="password"
                                            placeholder="Digite sua senha" value="<%= valores.password  %>"
                                            class="<%= erroValidacao.password %>" required>
                                        <button type="button" class="password-toggle" id="togglePassword">
                                            <i class="bx bx-hide"></i>
                                        </button>
                                    </section>
                                    <span><%= msgErro.password %></span>
                                </section>
                            </section>

                            <section class="continue-button">
                                <button type="submit">Entrar</button>
                            </section>

                            <% if (retorno && retorno.tipo === 'erro') { %>
                                <p style="color: red; text-align: center; margin-top: 8px;"><%= retorno.msg %></p>
                            <% } else if (retorno && retorno.tipo === 'sucesso') { %>
                                <p style="color: #28a745; text-align: center; margin-top: 8px;"><%= retorno.msg %></p>
                            <% } %>

                        </form>

                        <p class="texto-secundario" style="margin: 12px 0;">ou</p>

                        <a href="/auth/google" class="google-login-btn">
                            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.6-6 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.6 5.1 29.6 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.5-.4-3.5z"/>
                                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34.6 5.1 29.6 3 24 3 16.3 3 9.6 7.3 6.3 14.7z"/>
                                <path fill="#4CAF50" d="M24 45c5.5 0 10.4-1.9 14.3-5.1l-6.6-5.6C29.6 36.1 27 37 24 37c-5.3 0-9.7-3.4-11.3-8.1l-6.6 5.1C9.5 40.6 16.2 45 24 45z"/>
                                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.2-4 5.6l6.6 5.6C41.3 36.7 45 30.9 45 24c0-1.4-.1-2.5-.4-3.5z"/>
                            </svg>
                            Entrar com o Google
                        </a>

                        <p class="texto-secundario">Não tem conta? <a href="/cadastro">Cadastre-se aqui</a></p>


                    </section>
                </section>
            </main>
            <%- include('../partials/footer.ejs') %>
            <script src="../js/text.js"></script>

</body>

</html>